#> mhdp_monster_{{name}}:core/tick/animation/change/play/main
#
# アニメーション変更処理 再生
#
# @within function mhdp_monster_{{name}}:core/tick/animation/change/main

# 行動回数加算
    scoreboard players add @s Mns.General.ActCount.Idle 1

# 移動
    execute if entity @s[tag=Anim.Walk] run function animated_java_{{name}}:{{name}}/animations/{{anim.walk_relax}}/tween {duration:5, to_frame: 5}

# 生態行動
    execute if entity @s[tag=Anim.Ecology] run function animated_java_{{name}}:{{name}}/animations/{{anim.ecology}}/tween {duration:1, to_frame: 1}
    execute if entity @s[tag=Anim.Ecology.Long] run function animated_java_{{name}}:{{name}}/animations/{{anim.ecology_long}}/tween {duration:1, to_frame: 1}

# 探索
    execute if entity @s[tag=Anim.Search] run function animated_java_{{name}}:{{name}}/animations/{{anim.search}}/tween {duration:1, to_frame: 1}

# 待機
    execute if entity @s[tag=Anim.Idle] run function animated_java_{{name}}:{{name}}/animations/{{anim.idle}}/tween {duration:1, to_frame: 1}

# 咆哮
    execute if entity @s[tag=Anim.Voice] run function animated_java_{{name}}:{{name}}/animations/{{anim.voice}}/tween {duration:1, to_frame: 1}

# 怒り開始
    execute if entity @s[tag=Anim.Anger] run function animated_java_{{name}}:{{name}}/animations/{{anim.anger}}/tween {duration:1, to_frame: 1}

# 軸合わせ
    # change/play/turn で実行

# 攻撃 (技を追加したら追記)
#   execute if entity @s[tag=Anim.<技名>] run function animated_java_{{name}}:{{name}}/animations/<anim>/tween {duration:1, to_frame: 1}

# タグ消去
    function mhdp_monsters:core/util/other/remove_animation_tag
    tag @s remove Mns.Temp.IsCombo
