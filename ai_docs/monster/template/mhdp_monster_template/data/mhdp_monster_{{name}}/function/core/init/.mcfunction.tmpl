#> mhdp_monster_{{name}}:core/init/
#
# データ初期化処理を行う
#
# @within function mhdp_monster_{{name}}:core/summon/*

# 共通処理
    function mhdp_monsters:core/super/init/

# ボスバー作成
    bossbar add mhdp_monster:{{name}} {"text":""}
    function mhdp_monsters:core/util/tick/update_bossbar.m {Monster:"{{name}}",State:"relax"}
    execute store result bossbar mhdp_monster:{{name}} max run scoreboard players get @s Mns.Hp
    execute store result bossbar mhdp_monster:{{name}} value run scoreboard players get @s Mns.Hp

# 同士討ちダメージ有効化
    function mhdp_monsters:core/util/tick/event/enable_damage.m {Name:"{{name}}"}

# 部位耐久値 (Mns.Hp × <Part>PartDamage / 100)
{{#parts}}
    # {{part_ja}}
        # 基礎値取得
            execute store result score @s Mns.{{Upper}}.{{Part}}.Damage run scoreboard players get @s Mns.Hp
        # 倍率取得
            execute store result score #mhdp_temp_multiply MhdpCore run data get storage mhdp_core:temp TargetMonsterData.{{Part}}PartDamage
        # 計算
            scoreboard players operation @s Mns.{{Upper}}.{{Part}}.Damage *= #mhdp_temp_multiply MhdpCore
            execute store result score @s Mns.{{Upper}}.{{Part}}.Damage.Max run scoreboard players operation @s Mns.{{Upper}}.{{Part}}.Damage /= #const_100 Const
{{/parts}}

# その他スコア初期化
    # 怯み回数
{{#parts}}
        scoreboard players set @s Mns.{{Upper}}.{{Part}}.Damage.Count 0
{{/parts}}

# 終了
    scoreboard players reset #mhdp_temp_monster_uid Mns.Uid

# アニメーション再生
    # 待機
        execute if entity @s[tag=Mns.Temp.IsIdleAnimation] run function animated_java_{{name}}:{{name}}/animations/{{anim.idle_relax}}/play
