#> mhdp_monster_{{name}}:core/tick/animation/change/on_battle/{{range}}
#
# アニメーション変更処理 戦闘時 {{range_ja}}
#
# @within function mhdp_monster_{{name}}:core/tick/animation/change/on_battle/main

# ※ 距離帯ごとに 1 ファイル展開する ({{range}} = move / near / middle / far)
# ※ 技が 1 つも無い間は「決定」〜「Animタグ付与」をコメントアウトし、仮行動として待機させる

# 状態取得
    function mhdp_monsters:core/util/tick/animation/check_player_situation.m {Tag:"Mns.Target.{{Upper}}"}

# 基礎確率設定 (技名:重み)
    data modify storage mhdp_core:temp Temp.AttackRandom set value {{{weights}}}
# 状態に応じた確率上書き
    # 正面時
        # execute if entity @a[tag=Mns.Target.{{Upper}},tag=Mns.Temp.Situation.IsForward] run data modify storage mhdp_core:temp Temp.AttackRandom merge value {}
    # 背面時
        # execute if entity @a[tag=Mns.Target.{{Upper}},tag=Mns.Temp.Situation.IsBack] run data modify storage mhdp_core:temp Temp.AttackRandom merge value {}
    # 怒り
        # execute if entity @s[tag=Mns.State.IsAnger] run data modify storage mhdp_core:temp Temp.AttackRandom merge value {}

# 決定 (macro/m.{{range}} の loot で抽選し、#mndp_temp_action_id に番号が入る)
    function mhdp_monsters:core/util/tick/animation/decide_animation.m {Monster:"{{name}}",State:"{{range}}"}

# 状態リセット
    data remove storage mhdp_core:temp Temp.AttackRandom
    function mhdp_monsters:core/util/tick/animation/remove_tag

# Animタグ付与 (番号は macro/m.{{range}} の Id と対応させる)
{{#attacks}}
    # {{attack_ja}}
        execute if score #mndp_temp_action_id MhdpCore matches {{attack_id}} run tag @s add Anim.{{Attack}}
{{/attacks}}

# 軸合わせ要否確認
    function mhdp_monster_{{name}}:core/tick/animation/change/on_battle/turn

# 終了
{{#is_move}}
    scoreboard players set @s Mns.General.ActCount.Move 0
{{/is_move}}
    scoreboard players reset #mndp_temp_action_id MhdpCore
