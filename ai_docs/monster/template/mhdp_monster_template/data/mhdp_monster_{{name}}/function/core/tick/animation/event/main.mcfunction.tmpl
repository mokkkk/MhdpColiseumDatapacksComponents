#> mhdp_monster_{{name}}:core/tick/animation/event/main
#
# アニメーションイベントハンドラ
#
# @within function mhdp_monster_{{name}}:core/tick/main

# ※ 再生中アニメの .playing タグを見て、event/<anim>/main を呼ぶだけのディスパッチャ
# ※ 存在しない関数を呼ぶ行があるとこのファイル自体が読み込まれず、core/tick/main も動かなくなる。
#   event/<anim>/ を実装したアニメの行だけコメントを外すこと

## 非発見時

# 待機
    # execute if entity @s[tag=animated_java_{{name}}.{{name}}.animation.{{anim.idle_relax}}.playing] run function mhdp_monster_{{name}}:core/tick/animation/event/{{anim.idle_relax}}/main
# 移動
    # execute if entity @s[tag=animated_java_{{name}}.{{name}}.animation.{{anim.walk_relax}}.playing] run function mhdp_monster_{{name}}:core/tick/animation/event/{{anim.walk_relax}}/main
