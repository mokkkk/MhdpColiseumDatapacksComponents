#> mhdp_monster_{{name}}:core/tick/on_battle/update_target
#
# tick処理 戦闘中 ターゲット更新
#
# @within function mhdp_monster_{{name}}:core/tick/on_battle/check_target

# ターゲットリセット
    tag @a remove Mns.Target.{{Upper}}

# ヘイトが最も高いプレイヤーにターゲットタグを付与
    function mhdp_monsters:core/util/tick/fetch_player/check_max_hate.m {CandidateTag:"Mns.Candidate.{{Upper}}",TargetTag:"Mns.Target.{{Upper}}",Score:"Mns.{{Upper}}.Hate"}
    # 誰にも付与できなかった場合、最も近くのプレイヤーに付与
        execute unless entity @a[tag=Mns.Target.{{Upper}}] as @p[tag=Mns.Candidate.{{Upper}}] run tag @s add Mns.Target.{{Upper}}

# ターゲットになったプレイヤーのヘイトを減少
    scoreboard players remove @a[tag=Mns.Target.{{Upper}}] Mns.{{Upper}}.Hate 300
    execute as @a[tag=Mns.Target.{{Upper}}] if score @s Mns.{{Upper}}.Hate matches ..-1 run scoreboard players set @s Mns.{{Upper}}.Hate 0

# ターゲット変更用の行動回数リセット
    scoreboard players set @s Mns.General.ActCount.Target 0
