#> mhdp_monster_{{name}}:core/util/end_blink
#
# まばたき終了時のモデル変更
#
# @within function mhdp_monsters:core/switch/macro/m.end_blink

# モデル変更
    # 通常
    execute if entity @s[tag=!Mns.Break.Head] run function animated_java_{{name}}:{{name}}/as_node {name: '{{blink_node}}', command: \
        'data modify entity @s item.components."minecraft:item_model" set value "animated_java_{{name}}:blueprint/{{name}}/{{blink_node}}"'\
    }
    # apply_blink に分岐を追加したら、こちらにも対応する戻し先モデルを追加する
    # (例: Mns.Break.Head → "minecraft:aj_sub/{{name}}/{{blink_node}}_break")
