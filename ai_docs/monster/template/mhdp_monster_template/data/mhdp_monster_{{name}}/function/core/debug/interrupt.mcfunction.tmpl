#> mhdp_monster_{{name}}:core/debug/interrupt
#
# デバッグ用 任意のアニメーションを強制発火する
#
# @private

# 実行者変更
    execute unless entity @s[type=item_display,tag=Mns.Root.{{Upper}}] as @n[type=item_display,tag=Mns.Root.{{Upper}}] at @s run return run function mhdp_monster_{{name}}:core/debug/interrupt

# 攻撃データ更新のため、register実行
    function mhdp_monster_{{name}}:core/register

# 通常攻撃用
    # タグ付与 (確認したい技の Anim タグに書き換える)
        tag @s add Anim.Voice
    # 軸合わせ
        # tag @s add Mns.Temp.IsTurn
        # scoreboard players set @s Mns.General.TurnCount 1
    # アニメーション変更
        return run function mhdp_monster_{{name}}:core/tick/animation/change/main

