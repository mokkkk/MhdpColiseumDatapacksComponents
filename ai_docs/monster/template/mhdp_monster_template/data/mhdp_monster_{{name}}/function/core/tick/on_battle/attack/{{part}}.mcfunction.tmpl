#> mhdp_monster_{{name}}:core/tick/on_battle/attack/{{part}}
#
# tick処理 戦闘中 攻撃 ({{part_ja}})
#
# @within function mhdp_monsters:core/switch/macro/m.start_attack

# ※ AttackData の AttackPart に使う部位ごとに 1 ファイル展開する

# エラー検知用
    execute if entity @s[type=item_display] run return 1

# 攻撃中タグ付与
    execute if entity @s[type=slime,tag=Mns.HitBox.{{Upper}}.{{Part}}] run tag @s add Mns.State.IsAttackPart
